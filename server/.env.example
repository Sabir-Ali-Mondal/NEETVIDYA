# =============================================================================
# NEETVIDYA - Backend environment variables
# =============================================================================
# Copy this file to `.env` (same folder) and fill in the real values:
#   PowerShell : Copy-Item .env.example .env
#   cmd        : copy .env.example .env
#
# `.env` is git-ignored and must never be committed or shared.
#
# The server boots with only MONGODB_URI set. Every other value falls back to a
# development default, but email and file uploads will not work without theirs.
#
# NOTE: lines beginning with `#` are comments. Do not wrap values in quotes, and
# do not add spaces around the `=` sign.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the Express API listens on. On a host like Render, that platform injects
# its own PORT and this value is ignored - do not hardcode the port in production.
PORT=5000

# `development` | `production`.
# development -> verbose request logging (morgan) and error stack traces in API
#                responses.
# production  -> logging and stack traces are suppressed. Use this on Render.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------
# REQUIRED. The only variable with no usable fallback.
# Local MongoDB:
#   mongodb://localhost:27017/neetvidya
# MongoDB Atlas (used in production) - get it from Atlas ->
#   Cluster -> Connect -> Drivers -> "Node.js driver":
#   mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
#
# If the password contains @ : / ? # [ ] % or &, it must be URL-encoded,
# e.g. `p@ss#1` becomes `p%40ss%231`, or the connection string will be invalid.
MONGODB_URI=mongodb://localhost:27017/neetvidya


# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Secrets used to sign login tokens. Anyone who knows a production secret can
# mint a valid admin token, so replace BOTH on a real deployment with long
# random strings (40+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Changing a secret instantly logs out every user holding a token signed by the
# old one.
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# How long a token stays valid: 7d = 7 days. Access tokens are short-lived;
# the refresh token is the long-lived one that mints new access tokens.
# Accepted units: s (seconds), m (minutes), h (hours), d (days).
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d


# -----------------------------------------------------------------------------
# File uploads (Cloudinary)
# -----------------------------------------------------------------------------
# Used for study materials, PDFs, images, profile photos and exam covers.
# Get these from https://console.cloudinary.com -> Dashboard.
#
# The server starts without them (it falls back to dummy credentials), but any
# upload will fail. Never expose the API secret to the frontend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# -----------------------------------------------------------------------------
# Frontend URL
# -----------------------------------------------------------------------------
# Base URL that gets baked into the links inside outgoing emails
# (verify-email / reset-password). It MUST point at the deployed frontend in
# production or every verification link will open localhost and break.
#
#   local : http://localhost:5173
#   prod  : https://your-app.vercel.app
#
# No trailing slash.
CLIENT_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# Email delivery (Resend HTTPS API)
# -----------------------------------------------------------------------------
# Emails are sent over the Resend HTTPS API, NOT over SMTP. SMTP is deliberately
# not used: many hosts block outbound SMTP ports, which shows up as a
# "Connection timeout" and silently loses the mail. HTTPS works everywhere.
#
# 1. Create an account at https://resend.com
# 2. API Keys -> Create API Key (permission: Sending)
# 3. Paste the key below.
#
# Server-side only. Never expose this key to the frontend and never prefix it
# with VITE_ (Vite would ship it to the browser in the JS bundle).
RESEND_API_KEY=re_your_resend_api_key

# The From address shown to recipients.
#
# Sandbox (no setup, testing only):
#   NEETVIDYA <onboarding@resend.dev>
#   Resend only delivers from this address to the email you signed up with.
#
# Production (required to email real students):
#   1. Resend -> Domains -> Add Domain, then add the SPF/DKIM DNS records shown.
#   2. Wait until the domain status is "Verified".
#   3. Use an address on that domain here.
#
# Sending from an unverified domain makes Resend reject the request.
# Leave blank to fall back to the sandbox sender above.
EMAIL_FROM=NEETVIDYA <onboarding@resend.dev>


# -----------------------------------------------------------------------------
# Seed admin account (optional - used only by `npm run seed`)
# -----------------------------------------------------------------------------
# These override the built-in defaults when creating the initial admin.
# Omit them entirely to use the defaults.
#
# `npm run seed` creates the admin ONLY. It does not create teachers, students,
# batches or courses - everything else is built from the admin panel.
ADMIN_NAME=NEETVIDYA Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_before_first_run
ADMIN_PHONE=+91 00000 00000
